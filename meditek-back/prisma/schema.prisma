// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int      @id @default(autoincrement())
  firebaseUid String   @unique
  email       String   @unique
  name        String
  dni         String   @unique
  age         Int
  phone       String?
  role        Role     @default(PATIENT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relaciones
  doctor      Doctor?
  patient     Patient?
}

model Doctor {
  id           Int       @id @default(autoincrement())
  specialtyId  Int
  specialty    Specialty @relation(fields: [specialtyId], references: [id])
  specialtyName String
  userId       Int       @unique
  user         User      @relation(fields: [userId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  // Relaciones
  consultations Consultation[]
  treatments    Treatment[]
  referrals     Referral[]
}

model Patient {
  id           Int       @id @default(autoincrement())
  userId       Int       @unique
  user         User      @relation(fields: [userId], references: [id])
  address      String?
  bloodType    String?
  allergies    String[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  // Relaciones
  medicalHistory MedicalHistory?
  consultations  Consultation[]
  treatments     Treatment[]
  prescriptions  Prescription[]
  referrals      Referral[]  // Una sola relación
}

model MedicalHistory {
  id              Int      @id @default(autoincrement())
  patientId       Int      @unique
  patient         Patient  @relation(fields: [patientId], references: [id])
  chronicDiseases String[]
  surgeries       String[]
  familyHistory   String?
  medications     String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Consultation {
  id           Int       @id @default(autoincrement())
  patientId    Int
  patient      Patient   @relation(fields: [patientId], references: [id])
  doctorId     Int
  doctor       Doctor    @relation(fields: [doctorId], references: [id])
  date         DateTime  @default(now())
  symptoms     String?
  diagnosis    String
  observations String?
  status       String    @default("completed")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  // Relaciones
  treatment    Treatment?
  prescription Prescription?
}

model Treatment {
  id              Int            @id @default(autoincrement())
  consultationId  Int?           @unique
  consultation    Consultation?  @relation(fields: [consultationId], references: [id])
  patientId       Int
  patient         Patient        @relation(fields: [patientId], references: [id])
  doctorId        Int
  doctor          Doctor         @relation(fields: [doctorId], references: [id])
  description     String
  duration        Int
  durationUnit    String
  medications     Json
  startDate       DateTime
  endDate         DateTime
  status          String         @default("active")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  evolutions      Evolution[]
}

model Evolution {
  id          Int       @id @default(autoincrement())
  treatmentId Int
  treatment   Treatment @relation(fields: [treatmentId], references: [id])
  date        DateTime  @default(now())
  notes       String
  doctorName  String
  createdAt   DateTime  @default(now())
}

model Prescription {
  id             Int          @id @default(autoincrement())
  consultationId Int          @unique
  consultation   Consultation @relation(fields: [consultationId], references: [id])
  patientId      Int
  patient        Patient      @relation(fields: [patientId], references: [id])
  medications    String
  instructions   String?
  hospitalSeal   String
  createdAt      DateTime     @default(now())
}

model Referral {
  id             Int       @id @default(autoincrement())
  patientId      Int
  patient        Patient   @relation(fields: [patientId], references: [id])
  fromSpecialty  String
  toSpecialtyId  Int
  toSpecialty    Specialty @relation(fields: [toSpecialtyId], references: [id])
  reason         String
  doctorId       Int
  doctor         Doctor    @relation(fields: [doctorId], references: [id])
  status         String    @default("pending")
  newAppointment DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Specialty {
  id          Int      @id @default(autoincrement())
  name        String
  icon        String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relaciones
  doctors     Doctor[]
  referrals   Referral[]
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String
  price       Float
  stock       Int
  description String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum Role {
  ADMIN
  DOCTOR
  PATIENT
}